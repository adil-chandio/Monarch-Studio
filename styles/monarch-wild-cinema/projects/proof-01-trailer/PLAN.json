    "narration": {
      "voice": "voice-01 (Arena) — masculine narration, en-US",
      "lines": [
        {
          "n": 1,
          "shot": "01",
          "at": 0.45,
          "file": "vo/line_01.mp3",
          "text": "Forty metres. Three seconds. Then it's a decision."
        },
        {
          "n": 2,
          "shot": "02",
          "at": 4.35,
          "file": "vo/line_02.mp3",
          "text": "And your first instinct is the wrong one."
        },
        {
          "n": 3,
          "shot": "03",
          "at": 8.05,
          "file": "vo/line_03.mp3",
          "text": "Most grizzly charges are not attacks. They're tests."
        },
        {
          "n": 4,
          "shot": "04",
          "at": 12.15,
          "file": "vo/line_04.mp3",
          "text": "Thirty-five miles an hour. Faster than the fastest man alive."
        },
        {
          "n": 5,
          "shot": "05",
          "at": 16.45,
          "file": "vo/line_05.mp3",
          "text": "So running is the one answer that never works."
        },
        {
          "n": 6,
          "shot": "06",
          "at": 20.45,
          "file": "vo/line_06.mp3",
          "text": "Bear spray worked ninety-two percent of the time."
        },
        {
          "n": 7,
          "shot": "07",
          "at": 24.3,
          "file": "vo/line_07.mp3",
          "text": "Three things to remember."
        },
        {
          "n": 8,
          "shot": "08",
          "at": 27.95,
          "file": "vo/line_08.mp3",
          "text": "It wasn't charging you. It was testing you."
        }
      ]
    },
