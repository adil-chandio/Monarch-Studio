  "narration": [
    {
      "file": "01_hook.wav",
      "start": 0.24,
      "duration": 6.6,
      "text": "کانٹا سکن میں پھنس جائے، تو باڈی کیا کرتی ہے؟ ٹِپ باہر ہو، تو نکالنا آسان ہوتا ہے۔"
    },
    {
      "file": "02_response.wav",
      "start": 7.0,
      "duration": 8.4,
      "text": "لیکن اندر پھنس جائے، تو ڈیفینس سیلز اس کے گرد جمع ہوتے ہیں۔ سوجن آ سکتی ہے۔ انفیکشن ہو، تو پیپ بھی بن سکتی ہے۔"
    },
    {
      "file": "03_movement.wav",
      "start": 15.56,
      "duration": 6.36,
      "text": "کبھی چھوٹا کانٹا سکن کی سطح تک آ جاتا ہے۔ لیکن ہر بار نہیں! اس کا انتظار مت کرو۔"
    },
    {
      "file": "04_safety.wav",
      "start": 22.08,
      "duration": 7.32,
      "text": "گہرا کانٹا، بڑھتی لالی، درد یا پیپ ہو، تو ڈاکٹر سے مدد لو۔ سکن کو مت کھودو۔"
    }
  ],
