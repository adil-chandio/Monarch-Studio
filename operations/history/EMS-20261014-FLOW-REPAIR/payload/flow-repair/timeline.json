  "captions": [
    {
      "start": 0.26833300000000004,
      "end": 1.698333,
      "text": "1915 mein,"
    },
    {
      "start": 1.798333,
      "end": 2.978333,
      "text": "Albert Einstein gravity ka masla"
    },
    {
      "start": 2.8883330000000003,
      "end": 5.208333,
      "text": "hal nahi kar paa rahe thay."
    },
    {
      "start": 5.468333,
      "end": 7.498333,
      "text": "Unki equations nakaam ho rahi theen."
    },
    {
      "start": 7.601667,
      "end": 9.211667,
      "text": "Phir raat ke 2 baje,"
    },
    {
      "start": 9.351667,
      "end": 10.631667,
      "text": "unhon ne chalk rakha,"
    },
    {
      "start": 10.761667000000001,
      "end": 11.881667,
      "text": "violin uthaya,"
    },
    {
      "start": 12.071667000000001,
      "end": 13.831667,
      "text": "aur mombatti ki roshni mein"
    },
    {
      "start": 13.861667,
      "end": 15.281667,
      "text": "Mozart bajane lage."
    },
    {
      "start": 15.641667000000002,
      "end": 17.591666999999998,
      "text": "Udhar padosi deewarein peet rahe thay."
    },
    {
      "start": 17.701666999999997,
      "end": 19.681666999999997,
      "text": "Woh math se bhaag nahi rahe thay,"
    },
    {
      "start": 19.831666999999996,
      "end": 21.801667,
      "text": "balki flow state mein ja rahe thay."
    },
    {
      "start": 22.111666999999997,
      "end": 23.701666999999997,
      "text": "Ussi haalat ko aaj hum"
    },
    {
      "start": 23.611666999999997,
      "end": 25.761667,
      "text": "AI shortcuts se khud khatam kar rahe hain."
    },
    {
      "start": 25.868333,
      "end": 26.878332999999998,
      "text": "Zara socho."
    },
    {
      "start": 27.258332999999997,
      "end": 29.608333,
      "text": "Tez safar ke liye hamare paas cars hain."
    },
    {
      "start": 30.048333,
      "end": 31.348332999999997,
      "text": "Phir bhi hum subah daurne ke liye"
    },
    {
      "start": 31.258332999999997,
      "end": 33.248333,
      "text": "running shoes pehente hain."
    },
    {
      "start": 33.598333,
      "end": 34.078333,
      "text": "Kyun?"
    },
    {
      "start": 34.168333000000004,
      "end": 36.388333,
      "text": "Kyunke agar saara kaam engine kare,"
    },
    {
      "start": 36.488333,
      "end": 38.54833300000001,
      "text": "toh hamare muscles kamzor par jaate hain."
    },
    {
      "start": 38.708333,
      "end": 40.388333,
      "text": "Dimaagh ke saath bhi yehi hota hai."
    },
    {
      "start": 40.501667000000005,
      "end": 41.59166700000001,
      "text": "Jab shortcut"
    },
    {
      "start": 41.501667000000005,
      "end": 43.351667000000006,
      "text": "mehnat ki charhaai ki jagah le le,"
    },
    {
      "start": 43.511667,
      "end": 45.66166700000001,
      "text": "toh creative inflation paida hoti hai."
    },
    {
      "start": 45.768333000000005,
      "end": 47.028333,
      "text": "Efficiency barhti hai,"
    },
    {
      "start": 47.128333000000005,
      "end": 48.268333000000005,
      "text": "magar insaan ka talent"
    },
    {
      "start": 48.198333000000005,
      "end": 49.46833300000001,
      "text": "kam hota jaata hai."
    },
    {
      "start": 49.568332999999996,
      "end": 51.288333,
      "text": "Iss waqt hazaaron log"
    },
    {
      "start": 51.198333,
      "end": 53.068332999999996,
      "text": "khaali sports stadiums mein"
    },
    {
      "start": 53.088333,
      "end": 55.138332999999996,
      "text": "sirf bhaari sandbags uthane ke liye"
    },
    {
      "start": 55.04833299999999,
      "end": 56.778332999999996,
      "text": "bhaari fees de rahe hain."
    },
    {
      "start": 56.868333,
      "end": 58.848333000000004,
      "text": "Yeh art ke khaufnaak future ke baare mein"
    },
    {
      "start": 58.758333,
      "end": 60.358333,
      "text": "jo batata hai,"
    },
    {
      "start": 60.408333,
      "end": 61.478333,
      "text": "woh sunne ke liye tum"
    },
    {
      "start": 61.388332999999996,
      "end": 62.578333,
      "text": "abhi tayyaar nahi ho."
    }
  ],
