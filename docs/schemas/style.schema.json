{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editing-monarch.local/schemas/style.schema.json",
  "title": "Editing Monarch permanent style",
  "type": "object",
  "required": ["schema_version", "style_id", "name", "workflow_code", "path", "lifecycle", "knowledge_index"],
  "properties": {
    "schema_version": {"const": 1},
    "style_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "workflow_code": {"type": "string", "pattern": "^WF-[0-9]{2,}$"},
    "path": {"type": "string", "pattern": "^styles/"},
    "lifecycle": {"const": "permanent"},
    "active_work_is_allowed_here": {"const": false},
    "knowledge_index": {"type": "string"}
  },
  "additionalProperties": true
}
